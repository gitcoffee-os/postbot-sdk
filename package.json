{
  "name": "@gitcoffee-os/postbot-sdk",
  "version": "1.0.0",
  "description": "PostBot & Postar SDK - API client, auth, and domain models for content publishing",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "tsc && vitest run"
  },
  "keywords": [
    "postbot",
    "postar",
    "sdk",
    "api",
    "content-publishing",
    "social-media",
    "workflow"
  ],
  "license": "Apache-2.0",
  "author": "GitCoffee Team (https://gitcoffee.com)",
  "homepage": "https://postbot.exmay.com/docs",
  "repository": {
    "type": "git",
    "url": "https://github.com/gitcoffee-os/postbot-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/gitcoffee-os/postbot-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
